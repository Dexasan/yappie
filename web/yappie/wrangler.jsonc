{
  "name": "yappie-public",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "account_id": "b7f76118b8864538680dbaefd014743b",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "yappie.site", "custom_domain": true }],
  "vars": { "WEB_CHAT_ENABLED": "true" },
  "durable_objects": { "bindings": [
    { "name": "WEB_CHAT_POOL", "class_name": "GuestChatPool" },
    { "name": "VISITOR_COUNTER", "class_name": "VisitorCounter" },
    { "name": "STICKY_WALL", "class_name": "StickyWall" }
  ] },
  "migrations": [
    { "tag": "guest-chat-v1", "new_sqlite_classes": ["GuestChatPool"] },
    { "tag": "visitor-counter-v1", "new_sqlite_classes": ["VisitorCounter"] },
    { "tag": "sticky-wall-v1", "new_sqlite_classes": ["StickyWall"] }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/", "/index.html", "/chat", "/chat/", "/chat.html",
      "/chat-app", "/chat-api/*", "/auth/*",
      "/visitor-api/*", "/wall-api/*",
      "/about", "/conversation-starters", "/chat-safety", "/chat-rules",
      "/privacy", "/support", "/sitemap.xml", "/robots.txt",
      "/about.html", "/conversation-starters.html", "/chat-safety.html", "/chat-rules.html",
      "/privacy.html", "/support.html"
    ]
  }
}
